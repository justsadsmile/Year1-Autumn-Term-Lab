# Automatic text file detection
* text=auto

# ========== C# files ==========
*.cs text
*.csproj text
*.sln text
*.vb text
*.fs text
*.resx text

# ========== Binary files ==========
*.dll binary
*.exe binary
*.pdb binary
*.bin binary
*.so binary
*.dylib binary

# ========== NuGet ==========
packages.config text
*.nupkg binary
*.snupkg binary

# ========== Configuration files ==========
*.config text
*.json text
*.xml text
*.yml text
*.yaml text
*.md text
*.txt text

# ========== Unity (if used) ==========
*.meta text
*.unity binary
*.prefab binary
*.asset binary
*.mat binary
*.controller binary

# ========== End of line settings ==========
# Require LF for C# files (cross-platform compatibility)
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.config text eol=lf

# Scripts should use LF
*.sh text eol=lf
*.ps1 text eol=lf

# BAT files should use CRLF
*.bat text eol=crlf

# ========== Diff ignoring ==========
# Don't show diff for binary files
*.dll -diff
*.exe -diff
*.pdb -diff
*.zip -diff

# ========== Unity specifics ==========
# Ignore changes in some Unity folders
Library/ -diff
Temp/ -diff
Build/ -diff

# =========== For C ===================
